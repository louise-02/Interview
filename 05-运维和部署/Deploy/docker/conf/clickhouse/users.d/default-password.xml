<!-- ClickHouse 偏生产：覆盖 default 用户密码 -->
<!-- 复制到 /data/docker/clickhouse/conf/users.d/ 后 restart -->
<!-- 部署前修改密码；说明见 1、clickhouse.md → ClickHouse 配置与运维 -->

<clickhouse>
    <users>
        <default>
            <password replace="replace">ChangeMe_StrongPassword</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </default>
    </users>
</clickhouse>
